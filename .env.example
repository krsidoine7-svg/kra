# Neon Database (Pooled pour runtime App, Unpooled/Direct pour migrations Drizzle)
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION="eu-central-1"
NEON_STORAGE_BUCKET="portfolio-public"
NEXT_PUBLIC_MEDIA_BASE_URL=""

# Sécurité & Authentification Masquée (générer des valeurs aléatoires 32+ octets en prod)
ADMIN_SECRET_PATH="acces-studio-kra"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
SESSION_HMAC_SECRET="change-me-with-long-random-hex-secret-for-sessions-and-audit-logs"
IP_HASH_SALT="change-me-random-salt-for-ip-privacy"

# URL publique du site (pour OpenGraph, partage '...' et SEO/GEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""
NEON_AUTH_COOKIE_SECRET="change-me-with-32-plus-char-secret-for-neon-auth-cookies"

# Neon Realtime
NEON_REALTIME_URL=""
NEXT_PUBLIC_NEON_REALTIME_URL=""
NEON_REALTIME_SECRET=""

# Neon Functions
NEON_HELLO_FUNCTION_URL=""

